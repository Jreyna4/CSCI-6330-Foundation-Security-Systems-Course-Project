# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Data is never committed (see README > Data)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Run outputs. Remove these lines if you want to commit final results.
results/*
!results/.gitkeep

# Pilot run outputs (configs/pilot.yaml)
results_pilot/
data/processed_pilot/

